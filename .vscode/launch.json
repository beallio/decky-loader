{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Runtime Python tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests/runtime", "-p", "test_*.py"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONDONTWRITEBYTECODE": "1" }
        }
    ]
}
