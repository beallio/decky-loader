{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpmsetup",
            "type": "shell",
            "command": "pnpm --dir frontend install --frozen-lockfile",
            "problemMatcher": []
        },
        {
            "label": "buildfrontend",
            "type": "shell",
            "command": "pnpm --dir frontend run build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "watchfrontend",
            "type": "shell",
            "command": "pnpm --dir frontend run watch",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "testpython",
            "type": "shell",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests/runtime -p 'test_*.py'",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "testrust",
            "type": "shell",
            "command": "base=$TMPDIR; test -n \"$base\" || base=/var/tmp/omp-1000; CARGO_TARGET_DIR=\"$base/decky-cargo-target\" cargo test --manifest-path backend-rust/Cargo.toml --locked --workspace",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "buildruntime",
            "type": "shell",
            "command": "base=$TMPDIR; test -n \"$base\" || base=/var/tmp/omp-1000; python3 scripts/runtime/build.py --release-version dev --output \"$base/decky-runtime\"",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
